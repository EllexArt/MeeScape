{
  "compilerOptions": {
    "target": "ES2020",                          
    "module": "commonjs",                       
    "strict": true,                            
    "outDir": "dist",                          
    "rootDir": ".",                            
    "esModuleInterop": true,                   
    "moduleResolution": "node",                
    "resolveJsonModule": true,                 
    "isolatedModules": true,                   
    "skipLibCheck": true                       
  },
  "include": ["main.ts", "src"]
}
